		"@aws-sdk/lib-dynamodb": "^3.398.0",
		"@aws-sdk/lib-storage": "^3.817.0",
		"@jigjoy-io/ai-coding-client": "^0.0.5",
		"@jigjoy-io/mosaic": "^0.4.0",
		"@jigjoy-io/project-deployment-client": "^0.0.8",
		"@jigjoy-io/serverless-core": "^0.0.3",
		"@jigjoy-io/task-contracts": "^0.0.2",
