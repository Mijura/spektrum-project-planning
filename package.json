		"@types/node": "^25.3.0",
		"dotenv": "^17.3.1",
		"esbuild": "^0.27.3",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.1",
		"swagger-ui-watcher": "^2.1.14",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3"
	}
