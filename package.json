{
	"name": "project-planning",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"build": "sam build --profile Development",
		"deploy": "sam deploy --profile Development --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
		"serve": "sam local start-api --profile Development --host 0.0.0.0 --port 4000 --region eu-west-1 --env-vars env.json",
		"docs": "npx swagger-ui-watcher openapi.yaml --port 4040",
		"dev": "npm-run-all --parallel serve docs",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "rstest -c rstest.config.ts"
	},
