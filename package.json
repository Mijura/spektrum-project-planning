{
	"name": "project-planning",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"build:local": "sam build --profile spektrum-dev -t template.local.yaml ",
		"serve:local": "sam local start-api --profile spektrum-dev -t .aws-sam/build/template.yaml --host 0.0.0.0 --port 4000 --region eu-west-1 --env-vars env.json",
		"build:dev": "sam build --profile spektrum-dev",
		"deploy:dev": "sam deploy --profile spektrum-dev --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
		"docs": "npx swagger-ui-watcher openapi.yaml --port 4040",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "rstest -c rstest.config.ts"
	},
	"keywords": [],
	"author": "",
