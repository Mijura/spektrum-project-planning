		"npm-run-all": "^4.1.5",
		"prettier": "^3.7.4",
		"swagger-ui-watcher": "^2.1.14",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	}
