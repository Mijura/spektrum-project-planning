		"@aws-sdk/client-dynamodb": "^3.996.0",
		"@aws-sdk/client-s3": "^3.996.0",
		"@aws-sdk/lib-dynamodb": "^3.996.0",
		"@aws-sdk/lib-storage": "^3.996.0",
		"@heksagon/app": "^0.0.14",
		"@heksagon/http": "^0.0.9",
		"@jigjoy-ai/auth": "^0.1.0",
		"@jigjoy-ai/serverless-core": "^0.0.5",
		"@jigjoy-ai/spektrum-client": "^0.0.15",
		"@jigjoy-ai/task-contracts": "^0.0.3",
		"@mozaik-ai/core": "^0.8.4",
